# ====================================================================
# EduBuds Environment Variables
# Copy this file to .env.local for local testing with Vercel CLI (`vercel dev`)
# Add these variables to your Vercel Project Settings > Environment Variables
# ====================================================================

# ── WhatsApp Contact Configuration ──────────────────────────────────
# The primary WhatsApp phone number used for book orders and enquiries (digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# ── Database Option A: Supabase ─────────────────────────────────────
# (Recommended if using Supabase for DB, Auth, and Storage)
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Database Option B: Neon PostgreSQL ──────────────────────────────
# (Used if hosting PostgreSQL on Neon)
# Found in: Neon Console > Dashboard > Connection Details
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Authentication: Clerk.com ───────────────────────────────────────
# Found in: Clerk Dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Storage: Vercel Blob ────────────────────────────────────────────
# Found in: Vercel Dashboard > Storage > Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
