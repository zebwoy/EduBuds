# ====================================================================
# EduBuds Environment Variables
# Copy this file to .env.local for local testing (`vercel dev`)
# Add these variables to your Vercel Project Settings > Environment Variables
# ====================================================================

# ── Primary Database: Neon Serverless PostgreSQL ────────────────────
# Found in: Neon Console (https://console.neon.tech) > Project > Connection Details
# Use the pooled connection string (usually starts with postgresql:// or postgres://)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── CMS Authentication (Self-Contained JWT + Bcrypt) ────────────────
# 1. JWT Secret: Random 64-character secret key for signing admin tokens
#    Generate via: openssl rand -base64 48
#    Or run: node scripts/generate-hash.js --secret
JWT_SECRET=replace_with_a_secure_random_64_character_string

# 2. Admin Username for logging into /admin
ADMIN_USERNAME=edubuds_admin

# 3. Admin Password Hash: Bcrypt hash generated from your chosen password
#    Generate by running:
#      node scripts/generate-hash.js your_strong_password_here
ADMIN_PASSWORD_HASH=$2a$12$sampleHashPlaceholderGenerateYourOwnWithTheScriptAbove

# ── Media & Asset Storage (Optional — Phase 3) ──────────────────────
# Vercel Blob token for CMS media uploads (if using Vercel Blob)
# Found in: Vercel Dashboard > Storage > Blob Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_sample_token

# ── Optional Fallbacks ──────────────────────────────────────────────
# Default WhatsApp contact if not set in DB site_settings (digits only, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=919222315006
NEXT_PUBLIC_CONTACT_EMAIL=support@edubuds.in
